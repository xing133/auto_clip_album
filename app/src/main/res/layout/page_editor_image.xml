<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- Base image -->
    <com.autocrop.album.ui.editor.EditorImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/editor_title"
        android:scaleType="fitCenter" />

    <!-- Custom crop overlay view (will be created in code) -->
    <com.autocrop.album.ui.editor.CropOverlayView
        android:id="@+id/cropOverlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.autocrop.album.ui.editor.MaskEditView android:id="@+id/maskEditView"
        android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
</FrameLayout>
